# Copy to .env and fill in. .env is git-ignored and mounted read-only into every container.

# --- National Rail Data Portal (opendata.nationalrail.co.uk -> My Feeds -> Darwin) ---
# "Darwin Topic Information" box (live feed over STOMP/OpenWire)
username=DARWIN...
national_rail_password=
# "Darwin File Information" box (daily reference + timetable files on S3)
darwin_s3_access_key=
darwin_s3_secret_key=

# --- Databricks ---
# Workspace URL (anything copied from the browser address bar works)
databricks_host=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
# User Settings -> Developer -> Access tokens
databricks_token=

# Written by `darwin-setup` - leave blank
databricks_client_id=
databricks_client_secret=
zerobus_endpoint=
