/// Databricks workspace hostname (no https://). Change in Transform data > Edit parameters.
expression DatabricksHost = "dbc-43db7be9-e8fd.cloud.databricks.com" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	annotation PBI_ResultType = Text

/// HTTP path of the SQL warehouse (SQL Warehouses > Connection details).
expression DatabricksHttpPath = "/sql/1.0/warehouses/e26780c03dd20ee1" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	annotation PBI_ResultType = Text
