/// Databricks workspace hostname without https:// - e.g. dbc-1a2b3c4d-5e6f.cloud.databricks.com
/// (SQL Warehouses > your warehouse > Connection details > Server hostname).
expression DatabricksHost = "<your-workspace>.cloud.databricks.com" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	annotation PBI_ResultType = Text

/// HTTP path of the SQL warehouse (SQL Warehouses > your warehouse > Connection details > HTTP path).
expression DatabricksHttpPath = "/sql/1.0/warehouses/<warehouse-id>" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	annotation PBI_ResultType = Text

/// Unity Catalog catalog holding the Darwin tables (databricks_catalog in .env).
expression DatabricksCatalog = "workspace" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	annotation PBI_ResultType = Text

/// Schema holding the Darwin tables (databricks_schema in .env).
expression DatabricksSchema = "darwin" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	annotation PBI_ResultType = Text
