/// One row per train call (train x location x scheduled time) from workspace.darwin.fact_train_calls.
table fact_train_calls

	/// Distinct trains (RIDs) in the current filter context.
	measure Trains = DISTINCTCOUNT(fact_train_calls[train_service_id])
		formatString: #,0

	/// Passenger departures from public stops with an actual departure time.
	measure Departures = ```
			CALCULATE (
			    COUNTROWS ( fact_train_calls ),
			    NOT ISBLANK ( fact_train_calls[departure_delay_minutes] ),
			    fact_train_calls[call_type] = "Public stop",
			    fact_train_calls[is_passenger_service] = TRUE ()
			)
			```
		formatString: #,0

	/// Share of departures leaving at or before the public timetable time (to the minute).
	measure 'On time %' = ```
			DIVIDE (
			    CALCULATE ( [Departures], fact_train_calls[departure_delay_minutes] <= 0 ),
			    [Departures]
			)
			```
		formatString: 0.0%

	/// Share of departures within 5 minutes of the public timetable (PPM-style threshold).
	measure 'Within 5 minutes %' = ```
			DIVIDE (
			    CALCULATE ( [Departures], fact_train_calls[departure_delay_minutes] <= 5 ),
			    [Departures]
			)
			```
		formatString: 0.0%

	/// Mean departure delay in minutes (early departures count as negative).
	measure 'Average departure delay' = ```
			CALCULATE (
			    AVERAGE ( fact_train_calls[departure_delay_minutes] ),
			    fact_train_calls[call_type] = "Public stop",
			    fact_train_calls[is_passenger_service] = TRUE ()
			)
			```
		formatString: 0.0" min"

	/// Total minutes late across late departures.
	measure 'Delay minutes' = ```
			CALCULATE (
			    SUM ( fact_train_calls[departure_delay_minutes] ),
			    fact_train_calls[departure_delay_minutes] > 0,
			    fact_train_calls[call_type] = "Public stop",
			    fact_train_calls[is_passenger_service] = TRUE ()
			)
			```
		formatString: #,0

	/// Trains carrying a Darwin late-running reason.
	measure 'Delayed trains' = ```
			CALCULATE (
			    DISTINCTCOUNT ( fact_train_calls[train_service_id] ),
			    NOT ISBLANK ( fact_train_calls[late_reason_code] )
			)
			```
		formatString: #,0

	column call_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: call_id

	column train_service_id
		dataType: string
		summarizeBy: none
		sourceColumn: train_service_id

	column scheduled_start_date
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: scheduled_start_date

	column headcode
		dataType: string
		summarizeBy: none
		sourceColumn: headcode

	column operator_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: operator_code

	column train_category
		dataType: string
		summarizeBy: none
		sourceColumn: train_category

	column is_passenger_service
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: is_passenger_service

	column origin_name
		dataType: string
		summarizeBy: none
		sourceColumn: origin_name

	column destination_name
		dataType: string
		summarizeBy: none
		sourceColumn: destination_name

	column location_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: location_code

	column call_type
		dataType: string
		summarizeBy: none
		sourceColumn: call_type

	column scheduled_departure
		dataType: string
		summarizeBy: none
		sourceColumn: scheduled_departure

	column scheduled_timestamp
		dataType: dateTime
		formatString: dd mmm hh:nn
		summarizeBy: none
		sourceColumn: scheduled_timestamp

	column actual_departure
		dataType: string
		summarizeBy: none
		sourceColumn: actual_departure

	column departure_delay_minutes
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: departure_delay_minutes

	column arrival_delay_minutes
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: arrival_delay_minutes

	column platform
		dataType: string
		summarizeBy: none
		sourceColumn: platform

	column late_reason_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: late_reason_code

	column Journey = fact_train_calls[origin_name] & " → " & fact_train_calls[destination_name]
		dataType: string
		summarizeBy: none

	column 'Scheduled hour' = HOUR ( fact_train_calls[scheduled_timestamp] )
		dataType: int64
		formatString: 00
		summarizeBy: none

	column 'Delay band' = ```
			VAR d = fact_train_calls[departure_delay_minutes]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( d ), BLANK (),
			        d <= 0, "On time or early",
			        d <= 2, "1–2 min",
			        d <= 5, "3–5 min",
			        d <= 15, "6–15 min",
			        d <= 30, "16–30 min",
			        "Over 30 min"
			    )
			```
		dataType: string
		summarizeBy: none
		sortByColumn: 'Delay band order'

	column 'Delay band order' = ```
			VAR d = fact_train_calls[departure_delay_minutes]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( d ), BLANK (), d <= 0, 1, d <= 2, 2, d <= 5, 3, d <= 15, 4, d <= 30, 5, 6 )
			```
		dataType: int64
		isHidden
		summarizeBy: none

	partition fact_train_calls = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs(DatabricksHost, DatabricksHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null]),
				    Catalog = Source{[Name = DatabricksCatalog, Kind = "Database"]}[Data],
				    Schema = Catalog{[Name = DatabricksSchema, Kind = "Schema"]}[Data],
				    Calls = Schema{[Name = "fact_train_calls", Kind = "Table"]}[Data],
				    Selected = Table.SelectColumns(Calls, {
				        "call_id", "train_service_id", "scheduled_start_date", "headcode", "operator_code", "train_category", "is_passenger_service",
				        "origin_name", "destination_name", "location_code", "call_type", "scheduled_departure",
				        "scheduled_timestamp", "actual_departure", "departure_delay_minutes", "arrival_delay_minutes",
				        "platform", "late_reason_code"})
				in
				    Selected
