/// Darwin late-running reasons, shortened for display ("This train has been delayed by a fault..." -> "A fault...").
table dim_late_reason
	lineageTag: 9de70fce-73f7-4917-969d-c536a7433ae7

	column reason_code
		dataType: string
		isKey
		lineageTag: f469b9e2-8eaa-4fcc-a0cb-bb120f16ae47
		summarizeBy: none
		sourceColumn: reason_code

	column Reason
		dataType: string
		lineageTag: 8eec1b4a-1282-4409-a362-28c6754b3284
		summarizeBy: none
		sourceColumn: reason

	partition dim_late_reason = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs(DatabricksHost, DatabricksHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null]),
				    Catalog = Source{[Name = DatabricksCatalog, Kind = "Database"]}[Data],
				    Schema = Catalog{[Name = DatabricksSchema, Kind = "Schema"]}[Data],
				    Reasons = Schema{[Name = "late_reasons", Kind = "Table"]}[Data],
				    Shortened = Table.AddColumn(Reasons, "reason", each
				        let
				            text = List.Accumulate(
				                {"This train has been delayed by ", "This service has been delayed by "},
				                [reason_text], (state, prefix) => Text.Replace(state, prefix, ""))
				        in
				            Text.Upper(Text.Start(text, 1)) & Text.Middle(text, 1), type text),
				    Selected = Table.SelectColumns(Shortened, {"reason_code", "reason"})
				in
				    Selected

