/// Train operating companies.
table dim_operator

	column operator_code
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: operator_code

	column Operator
		dataType: string
		summarizeBy: none
		sourceColumn: operator_name

	partition dim_operator = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs(DatabricksHost, DatabricksHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null]),
				    Catalog = Source{[Name = DatabricksCatalog, Kind = "Database"]}[Data],
				    Schema = Catalog{[Name = DatabricksSchema, Kind = "Schema"]}[Data],
				    Operators = Schema{[Name = "operators", Kind = "Table"]}[Data],
				    Selected = Table.SelectColumns(Operators, {"operator_code", "operator_name"})
				in
				    Selected
